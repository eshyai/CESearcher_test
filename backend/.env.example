# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 模型名（必填，且必须是该端点真实存在的名字）----
# 填错不会报错、只会「静默失败」（六智能体表现为 2 秒返回空报告）。
# ⚠️ 注意避开「推理模型」：部分模型（如 deepseek-v4-*、kimi-k3）返回的
#    message.content 为空、内容在 reasoning_content 里，本项目未适配。
# 全局默认：六智能体（规划/分析/审核/写作/画图）+ chat 服务共用。
# 换 AI 供应商时改这一行即可整体切换（六智能体与 chat 都会跟着变）。
LLM_MODEL=qwen-plus
# 以下为按用途的单独覆盖（不设则继承 LLM_MODEL）
# 侦察员：搜索阶段调用频繁，宜用快模型
LLM_MODEL_SCOUT=qwen-flash
# 行业相关性闸 / 结构化抽取：逐批调用、量最大，宜用最便宜的模型
NEWS_INDUSTRY_GATE_MODEL=qwen-flash
NEWS_EXTRACT_MODEL=qwen-flash
# 可选：只想给某个 agent 换更强的模型（如写作换 qwen3.8-max）
# LLM_MODEL_WRITER=qwen3.8-max
# 可选：六智能体/chat 专用端点。不设则回落到 DASHSCOPE_BASE_URL。
# LLM_BASE_URL=
# 可选：chat 服务的遗留覆盖（不设则用 LLM_MODEL）
# OPENAI_MODEL=

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# Docker 默认配置，与 docker-compose.yml 保持一致
# 如果使用 Docker，无需修改以下配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=industry_assistant

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# ===== 注册准入（默认关闭自助注册）=====
# ALLOW_REGISTER=true                          → 完全开放自助注册（仅限可信内网）
# ALLOW_REGISTER=false + 邀请码非空             → 只能凭邀请码注册（默认）
# ALLOW_REGISTER=false + 邀请码为空             → 完全关闭，只能管理员建号
ALLOW_REGISTER=false
REGISTER_INVITE_CODE=

# ===== 交互式 API 文档（默认开启）=====
# 关闭后 /docs、/redoc、/openapi.json 一律 404。
# 生产环境已在 docker-compose.prod.yml 里显式设为 false；本地开发保持 true 即可。
ENABLE_DOCS=true

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai
