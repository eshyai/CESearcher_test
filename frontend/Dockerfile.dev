# 开发模式镜像：依赖烘焙进镜像，源码由 compose bind mount 覆盖。
# node_modules 通过命名卷挂载，避免被宿主机的 Windows 版 node_modules 覆盖。
FROM node:22-alpine

WORKDIR /app

# .npmrc 必须一起 COPY，npm ci 会读其中的 legacy-peer-deps
COPY package.json package-lock.json .npmrc ./
ENV HUSKY=0
RUN npm ci --registry=https://registry.npmmirror.com

EXPOSE 5183

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--mode", "docker"]
